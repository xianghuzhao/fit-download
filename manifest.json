{
  "manifest_version": 3,
  "name": "FIT Downloader",
  "version": "0.1.0",
  "description": "Download data from web as FIT files",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.imxingzhe.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.imxingzhe.com/workouts/*"],
      "js": ["content/fit_converter.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
